<Window x:Class="BakeryPOS.UI.Views.PosView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Panadería POS - Cobro" Height="768" Width="1024" WindowState="Maximized">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- Panel Izquierdo: Botones Táctiles de Panes -->
        <ScrollViewer Grid.Column="0">
            <UniformGrid Columns="4" x:Name="ProductGrid">
                <!-- Se llena dinámicamente con los productos -->
            </UniformGrid>
        </ScrollViewer>

        <!-- Panel Derecho: Carrito y Totales -->
        <Border Grid.Column="1" Background="#F4F4F4" Padding="15" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid ItemsSource="{Binding CartItems}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Pan" Binding="{Binding ProductName}" Width="*"/>
                        <DataGridTextColumn Header="Cant." Binding="{Binding Quantity, StringFormat={}{0:0.00}}"/>
                        <DataGridTextColumn Header="Total" Binding="{Binding Subtotal, StringFormat={}{0:C}}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="1" Margin="0,15,0,15">
                    <TextBlock Text="Total:" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="{Binding TotalAmount, StringFormat={}{0:C}}" FontSize="36" Foreground="Green" FontWeight="Bold"/>
                </StackPanel>

                <Button Grid.Row="2" Content="COBRAR" Command="{Binding ProcessPaymentCommand}" 
                        Height="60" Background="#27AE60" Foreground="White" FontSize="22" FontWeight="Bold"/>
            </Grid>
        </Border>
    </Grid>
</Window>